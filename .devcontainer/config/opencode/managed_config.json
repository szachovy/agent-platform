{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "instructions": [
    "/home/node/.opencode/AGENTS.md"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["context7-mcp"]
    },
    "backlog-md": {
      "type": "local",
      "command": ["backlog-mcp", "start"],
      "env": {
        "PWD": "/workspace"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest", "--browser", "chromium", "--executable-path", "/usr/bin/chromium", "--headless"],
      "env": {
        "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD": "1"
      }
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "read": {
      "*": "allow",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.crt": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.azure/**": "deny",
      "**/.config/gcloud/**": "deny",
      "**/.gnupg/**": "deny",
      "**/.kube/**": "deny",
      "**/.docker/**": "deny"
    },
    "edit": {
      "*": "allow",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.crt": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.azure/**": "deny",
      "**/.config/gcloud/**": "deny",
      "**/.gnupg/**": "deny",
      "**/.kube/**": "deny",
      "**/.docker/**": "deny"
    },
    "glob": {
      "*": "allow",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.crt": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.azure/**": "deny",
      "**/.config/gcloud/**": "deny",
      "**/.gnupg/**": "deny",
      "**/.kube/**": "deny",
      "**/.docker/**": "deny"
    },
    "grep": {
      "*": "allow",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.crt": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.azure/**": "deny",
      "**/.config/gcloud/**": "deny",
      "**/.gnupg/**": "deny",
      "**/.kube/**": "deny",
      "**/.docker/**": "deny"
    },
    "list": {
      "*": "allow",
      "**/.env*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.crt": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.azure/**": "deny",
      "**/.config/gcloud/**": "deny",
      "**/.gnupg/**": "deny",
      "**/.kube/**": "deny",
      "**/.docker/**": "deny"
    }
  }
}
